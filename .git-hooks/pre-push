#!/bin/sh

echo "Fixing SSL in pool.js..."
cat > backend/src/db/pool.js << 'POOLEOF'
const { Pool } = require('pg');

const pool = new Pool({
  host: process.env.DB_HOST || 'localhost',
  port: parseInt(process.env.DB_PORT || '5432'),
  database: process.env.DB_NAME || 'vendordb',
  user: process.env.DB_USER || 'vendoruser',
  password: process.env.DB_PASSWORD || 'vendorpass',
  ssl: process.env.DB_HOST ? { rejectUnauthorized: false } : false,
});

pool.on('error', (err) => {
  console.error('Unexpected DB error', err);
});

module.exports = pool;
POOLEOF
git add backend/src/db/pool.js

echo "Checking frontend build for errors..."
cd frontend
npm run build > /dev/null 2>&1
if [ $? -ne 0 ]; then
  echo ""
  echo "ERROR: Frontend build failed! Fix errors before pushing."
  npm run build 2>&1 | grep "error\|ERROR" | head -20
  cd ..
  exit 1
fi
cd ..

echo "All checks passed! Pushing..."
